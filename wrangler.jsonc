// Cloudflare settings: serve the static site in ./public. There is no server
// code; Cloudflare only hands out these files.
{
  "name": "safemerge",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Keep the safemerge.mmklabs-studio.workers.dev address working too
  "workers_dev": true,
  // Attach the site to its domain (Cloudflare creates the DNS records and certificate)
  "routes": [
    { "pattern": "safemergefiles.com", "custom_domain": true },
    { "pattern": "www.safemergefiles.com", "custom_domain": true }
  ]
}
